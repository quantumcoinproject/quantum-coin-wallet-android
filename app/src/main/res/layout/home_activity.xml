<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation= "vertical">

        <LinearLayout
            android:id="@+id/top_linear_layout_home_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@drawable/gradient_layer"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imageView_home_logo"
                android:layout_marginTop="3dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="center_horizontal|center_vertical"
                android:src="@drawable/header_logo" />
            <TextView
                android:id="@+id/textView_home_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:textColor="@color/colorCommon6"
                android:textSize="16dp"
                android:textAlignment="center"/>
            <TextView
                android:id="@+id/textView_home_load_seed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:textColor="@color/colorCommon6"
                android:textSize="16dp"
                android:textAlignment="center"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linerLayout_home_offline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_linear_layout_home_id"
            android:layout_alignParentBottom="true"
            android:background="@color/colorGainsboro"
            android:gravity="center_vertical|center_horizontal"
            android:paddingTop="150dp"
            android:visibility="gone">
                <include layout="@layout/retry_layout"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/center_relative_layout_home_id"
            android:layout_alignParentBottom="true"
            android:background="@android:color/transparent"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/frame_home_container_id"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/center_relative_layout_home_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/top_linear_layout_home_id"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/center_container">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView_home_wallet_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textSize="16dp"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="@color/colorCommon3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal|center_vertical"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imageButton_home_copy_clipboard"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:layout_gravity="center_vertical|left"
                            android:background="@drawable/image_selector"
                            android:src="@drawable/copy_outline"
                            app:tint="@color/colorCommon6" />

                        <TextView
                            android:id="@+id/textView_home_copied"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:textColor="@color/colorCommon6"
                            android:textSize="14dp"
                            android:visibility="gone"
                            android:layout_marginStart="4dp" />

                        <ImageButton
                            android:id="@+id/imageButton_home_block_explore"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:layout_gravity="center_vertical|left"
                            android:background="@drawable/image_selector"
                            android:src="@drawable/address_explore"
                            app:tint="@color/colorCommon6" />

                        <ImageButton
                            android:id="@+id/imageButton_home_refresh"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|left"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:background="@drawable/image_selector"
                            android:src="@drawable/retry"
                            app:tint="@color/colorCommon6" />

                        <ProgressBar
                            android:id="@+id/progress_home_loader"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|left"
                            android:padding="5dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            android:max="100"
                            android:progress="0"
                            android:background="@android:color/transparent"
                            android:indeterminateDrawable="@drawable/progress" />

                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView_home_coin_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="5dp"
                            android:textColor="@color/colorCommon6"
                            android:textSize="24dp"
                            android:textStyle="bold"
                            android:visibility="gone"/>

                        <!--
                            Default text is "-" (NOT "0"). The view starts
                            empty conceptually; "0" would be a misleading
                            authoritative claim that the wallet has no
                            funds before the balance fetch has even
                            returned. The "-" placeholder also matches the
                            seed-confirmation balance row in
                            home_wallet_fragment.xml so all three
                            balance-display surfaces (main / send / seed
                            confirm) read the same way before data lands.
                        -->
                        <TextView
                            android:id="@+id/textView_home_balance_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="5dp"
                            android:text="-"
                            android:textStyle="bold"
                            android:textSize="18dp"
                            android:textColor="@color/colorCommon6" />

                    </LinearLayout>

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:alpha="0.2"
                        android:background="@drawable/line_2_shape" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal|center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="#FFB400"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="12dp">

                                <ImageButton
                                    android:id="@+id/imageButton_home_send"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:padding="15dp"
                                    android:layout_gravity="center_vertical|left"
                                    android:layout_centerInParent="true"
                                    android:background="@drawable/image_selector"
                                    android:src="@drawable/arrow_up" />

                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/textView_home_send_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/transaction_list_headings"
                                android:textColor="@color/colorCommon6" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="#1DCC70"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="12dp">

                                <ImageButton
                                    android:id="@+id/imageButton_home_receive"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:padding="15dp"
                                    android:layout_gravity="center_vertical|left"
                                    android:layout_centerInParent="true"
                                    android:background="@drawable/image_selector"
                                    android:src="@drawable/arrow_down_outline" />


                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/textView_home_receive_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/transaction_list_headings"
                                android:textColor="@color/colorCommon6" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="#55D0F0"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="12dp">

                                <ImageButton
                                    android:id="@+id/imageButton_home_transactions"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:padding="15dp"
                                    android:layout_gravity="center_vertical|left"
                                    android:layout_centerInParent="true"
                                    android:background="@drawable/image_selector"
                                    android:src="@drawable/document" />

                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/textView_home_transactions_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/transaction_list_headings"
                                android:textColor="@color/colorCommon6" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>

        <!-- Burger menu (replaces the bottom navigation): Wallets / Settings. -->
        <ImageButton
            android:id="@+id/imageButton_home_burger"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:background="@drawable/burger_button_bg"
            android:src="@drawable/ic_burger"
            android:contentDescription="@string/nav_wallets_title" />

        <TextView
            android:id="@+id/textView_home_blockchain_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:padding="10dp"
            android:clickable="true"
            android:background="@drawable/text_link_selector_bg"
            android:drawableRight="@drawable/caret_down_outline"
            android:textStyle="bold"
            android:textSize="16dp"
            android:textColor="@drawable/text_link_selector"
            android:focusable="true"
            android:visibility="gone" />

    </RelativeLayout>

    <!-- Navigation drawer (burger menu): brand header on the app gradient,
         then icon rows with rounded press states and hairline dividers. -->
    <LinearLayout
        android:id="@+id/linearLayout_home_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/colorCommon7"
        android:orientation="vertical"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/linearLayout_drawer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_layer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/header_logo" />

            <TextView
                android:id="@+id/textView_drawer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorCommon6" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBurgerStroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:id="@+id/linearLayout_drawer_wallets"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/drawer_item_bg">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_wallet_outline" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorCommon6"
                    android:text="@string/nav_wallets_title" />
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/chevron_right"
                    app:tint="@color/colorMutedSecondaryText" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/colorBurgerFill" />

            <LinearLayout
                android:id="@+id/linearLayout_drawer_settings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/drawer_item_bg">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/m_settings"
                    app:tint="@color/colorCommon6" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorCommon6"
                    android:text="@string/nav_settings_title" />
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/chevron_right"
                    app:tint="@color/colorMutedSecondaryText" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>